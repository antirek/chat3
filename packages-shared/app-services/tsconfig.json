{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "composite": false,
    "paths": {
      "@chat3/models": ["../models/dist/index.js"],
      "@chat3/models/*": ["../models/dist/*.js"],
      "@chat3/utils": ["../utils/dist/index.js"],
      "@chat3/utils/*": ["../utils/dist/*.js"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/__tests__/**"]
}
